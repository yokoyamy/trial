function showCustomerMail(id){
    const c = state.customers.find(x=>x.id===id);
    if(!c) return;

    const url =
        location.href.split("#")[0] +
        "#answer/" + state.targetSurveyId + "/" + c.id;

    const body = state.sendState.body
        .replaceAll("{顧客名}",c.name)
        .replaceAll("{アンケートURL}",url);

