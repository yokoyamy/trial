/* =========================================================
   Survey numbering
========================================================= */

function renumberSurvey(survey){
    if(survey.numbering === "global"){
        let n = 1;
        survey.groups.forEach(group=>{
            group.questions.forEach(q=>{
                q.number = `Q${n++}`;
            });
        });
    }else{
        survey.groups.forEach((group,gi)=>{
            group.questions.forEach((q,qi)=>{
                q.number = `Q${gi+1}-${qi+1}`;
            });
        });
    }
}

